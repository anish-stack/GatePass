# Backend URL. Leave EMPTY when frontend & backend share a domain (Nginx /api proxy) or in dev (Vite proxy).
# Example for split hosting: VITE_API_URL=https://api.yourfactory.com
VITE_API_URL=

# Dev only: where Vite proxies /api
VITE_DEV_PROXY_TARGET=http://api.gatepass.imagecloud.online

# Show 1-click demo credentials on login page (set false in production)
VITE_SHOW_DEMO_LOGINS=true

# Allow simulated CCTV frame when no camera / permission denied (demo only; keep false in production)
VITE_ALLOW_SIMULATED_CAMERA=false
