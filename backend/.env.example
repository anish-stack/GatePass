# Server
PORT=5000
NODE_ENV=development

# Factory timezone - late / OT / date calculations use this zone
APP_TIMEZONE=Asia/Kolkata

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/factory_attendance?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=12h

# Allowed frontend origins (comma separated)
CLIENT_URL=http://localhost:5173

# Default admin created on first boot / seed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=Factory Superintendent / HR Admin

# Auto seed demo data when DB is empty (true/false)
AUTO_SEED=true

# Allow admin to reset DB to seed data from UI (true/false)
ALLOW_DB_RESET=true

# Max JSON body (camera photos are base64)
BODY_LIMIT=15mb
